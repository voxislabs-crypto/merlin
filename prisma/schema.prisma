// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  user          User     @relation(fields: [userId], references: [id])
  name          String?  @map("name")
  birthDate     DateTime? @map("birth_date")
  birthTime     String?  @map("birth_time")
  birthLocation String?  @map("birth_location")
  timeUnknown   Boolean  @default(false) @map("time_unknown")
  mbti          String?
  zodiacSign     String?  @map("zodiac_sign")
  risingSign     String?  @map("rising_sign")
  moonSign       String?  @map("moon_sign")
  lifePathNumber String?  @map("life_path_number")

  // Timestamps
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Indexes
  @@index([userId])

  // Map to database table name
  @@map("user_profiles")
}

model ResonanceFeedback {
  id        String   @id @default(uuid())
  userId    String   @map("user_id") // Optional: for user-specific feedback
  entityId  String   @map("entity_id") // The ID of the entity (e.g., aspect, transit)
  entityType String  @map("entity_type") // Type of entity (e.g., 'aspect', 'transit')
  score     Float    // Feedback score (-1 to 1)
  weight    Float    @default(1.0) // Initial weight of this feedback
  context   Json?    // Additional context about the feedback
  metadata  Json?    // Any additional metadata

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  expiresAt DateTime? @map("expires_at") // When this feedback should expire/decay

  // Indexes
  @@index([userId, entityId, entityType])
  @@index([expiresAt])

  // Map to database table name
  @@map("resonance_feedback")
}

model ResonanceWeight {
  id         String   @id @default(uuid())
  scope      String   // 'global', 'cluster', or 'user'
  scopeId    String?  @map("scope_id") // ID of the cluster or user (null for global)
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") // Optional: specific entity ID
  weight     Float    // The weight value
  decayRate  Float    @default(0.95) @map("decay_rate") // Per-day decay rate (0.95 = 5% decay per day)

  // Timestamps
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Composite unique constraint
  @@unique([scope, scopeId, entityType, entityId], name: "resonance_weight_unique")

  // Indexes
  @@index([scope, scopeId, entityType])

  // Map to database table name
  @@map("resonance_weights")
}

model Notification {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  type        String   // 'morning', 'evening', 'weekly'
  status      String   @default("scheduled") // 'scheduled', 'sent', 'read', 'failed'
  title       String
  content     Json     // Structured notification content
  scheduledAt DateTime @map("scheduled_at") // When the notification should be sent
  sentAt      DateTime? @map("sent_at") // When the notification was actually sent
  readAt      DateTime? @map("read_at") // When the user read the notification

  // User preferences
  channel     String   @default("app") // 'app', 'email', 'push'
  timezone    String   @default("UTC")

  // Metadata
  retryCount  Int      @default(0) @map("retry_count")
  lastError   String?  @map("last_error")

  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Indexes
  @@index([userId, status, scheduledAt])
  @@index([type, status, scheduledAt])

  // Map to database table name
  @@map("notifications")
}

model NotificationPreference {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")

  // Notification channels
  pushEnabled Boolean  @default(true) @map("push_enabled")
  emailEnabled Boolean @default(false) @map("email_enabled")

  // Timing preferences (in user's local time)
  morningTime String   @default("08:00") @map("morning_time") // Format: HH:MM
  eveningTime String   @default("20:00") @map("evening_time")
  weeklyDay   Int      @default(0) @map("weekly_day") // 0-6 (Sunday-Saturday)
  weeklyTime  String   @default("10:00") @map("weekly_time")

  // Notification types
  dailyEnabled  Boolean @default(true) @map("daily_enabled")
  weeklyEnabled Boolean @default(true) @map("weekly_enabled")

  // Content preferences
  themeEnabled  Boolean @default(true) @map("theme_enabled")
  aspectsEnabled Boolean @default(true) @map("aspects_enabled")
  mbtiEnabled   Boolean @default(true) @map("mbti_enabled")

  // Timestamps
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Map to database table name
  @@map("notification_preferences")
}

model BirthChart {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  birthDate         DateTime @map("birth_date")
  birthTime         String?  @map("birth_time") // Store as string in format "HH:MM"
  birthLocation     String?  @map("birth_location")
  latitude         Float
  longitude        Float
  planets          Json     // Array of planet positions
  houses           Json     // Array of house cusps
  aspects          Json?    // Array of aspects
  chartData        Json?    // Complete chart data
  isDefault        Boolean  @default(false) @map("is_default")
  julianDay        Float?   @map("julian_day")
  timeUnknown      Boolean  @default(false) @map("time_unknown")

  // Relations
  user             User     @relation(fields: [userId], references: [id])

  // Timestamps
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Indexes
  @@index([userId])
  @@index([isDefault])

  // Map to database table name
  @@map("birth_charts")
}

model User {
  id                String      @id @default(uuid())
  email             String      @unique
  name              String?
  defaultChartId    String?     @map("default_chart_id")
  birthChart       BirthChart[]
  profile           UserProfile?

  // Timestamps
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  @@map("users")
}
